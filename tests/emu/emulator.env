# Base manhunt.env for emulator runs (tools/emu_run.py adds the log file, auto exit and pad script).
# The release settings (scripts/make-release.py) plus the perf report.
RECOMP_SPAN_4G=1
MANHUNT_GPU_BACKEND=2
MANHUNT_AUDIO_APU=1
MANHUNT_WIDESCREEN=1
MANHUNT_AMBIENT_LIGHT=-1
MANHUNT_PERF_LOG=2
RECOMP_FPS_LOG=1
MANHUNT_LOG_SYNC=0
# The status-monitor FPS feed talks to another process over IPC; the emulator has none.
MANHUNT_STATUS_FPS=0
# Ryubing cuts every GL readback at width/4; read dumped frames through a wider target (nv2a_gl.c dump_read).
RECOMP_GL_DUMP_READ=wide
